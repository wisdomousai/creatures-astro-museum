---
import '../styles/global.css';
import { site, url } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Override the canonical URL, e.g. when a post was first published elsewhere. */
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  /** Keep the page out of search results (the page itself stays reachable). */
  noindex?: boolean;
  /** In the museum, is this a place to walk (the lobby, a wing) or a page to read (an
   * exhibit's, opened over the halls)? */
  museum?: 'walk' | 'read';
}

const {
  title,
  description: pageDescription = site.description,
  canonical,
  image,
  type = 'website',
  noindex = false,
  museum = 'read',
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const pageTitle = title ? `${title} – ${site.title}` : site.title;
const shareTitle = title || site.title;
const description = pageDescription;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
// Pages without a picture of their own share the site card.
const ogImage = new URL(image ?? url('/og.png'), Astro.site).href;
const isCurrent = (href: string) => path === url(href) || path.startsWith(`${url(href)}/`);
// Contact is a nav entry but renders as the header's button, not in the pill.
const sections = site.nav.filter((item) => item.href !== '/contact');
const contact = site.nav.find((item) => item.href === '/contact');
// The museum or the flat site (src/lib/mode.ts), decided before the page shows: the
// museum, unless this browser asked for the flat site (?flat, kept), can't draw it (no
// WebGL2), or is a search engine's or a robot's. ?museum brings it back.
const chooseMode = `(() => {
  const q = new URLSearchParams(location.search);
  let mode = q.has('museum') ? 'museum' : q.has('flat') ? 'flat' : null;
  try {
    if (mode) localStorage.setItem('mode', mode);
    else mode = localStorage.getItem('mode');
  } catch {}
  if (!mode && /bot|crawler|spider|slurp|lighthouse/i.test(navigator.userAgent)) mode = 'flat';
  if (mode !== 'flat') {
    try {
      if (!document.createElement('canvas').getContext('webgl2')) mode = 'flat';
    } catch {
      mode = 'flat';
    }
  }
  if (q.has('museum') || q.has('flat')) {
    q.delete('museum');
    q.delete('flat');
    const rest = q.toString();
    history.replaceState(null, '', location.pathname + (rest ? '?' + rest : '') + location.hash);
  }
  if (mode !== 'flat') document.documentElement.dataset.museum = ${JSON.stringify(museum)};
})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={chooseMode} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    {
      !image && (
        <Fragment>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </Fragment>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <header class="site-header page">
      <div class="bar">
        <div class="brand">
          <a class="wordmark" href={url('/')}>{site.title}</a>
        </div>
        <nav class="nav" aria-label="Main">
          {
            sections.map((item) => (
              <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="actions">
          {
            contact && (
              <a
                class="contact"
                href={url(contact.href)}
                aria-current={isCurrent(contact.href) ? 'page' : undefined}
              >
                {contact.label}
              </a>
            )
          }
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer page">
      <div class="foot">
        <p>{site.author}, {new Date().getFullYear()}</p>
        <p class="links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {site.links.github && <a href={site.links.github}>GitHub</a>}
          <a href={url('/rss.xml')}>RSS</a>
          <a href="?museum">The museum</a>
        </p>
      </div>
    </footer>

    <script>
      import { start } from '../lib/mode';
      void start();
    </script>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 10;
    width: auto;
    height: auto;
    padding: 0.5rem 0.75rem;
    clip-path: none;
    background: var(--ink);
    color: var(--paper);
  }

  /* Wordmark and actions on one row, the section pill below; from 66rem all three
     share a row with the pill centred. */
  .site-header {
    padding-top: calc(var(--band) + 0.5rem);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'mark actions'
      'nav nav';
    align-items: center;
    gap: 0.875rem 1rem;
    font-family: var(--font-sans);
  }

  /* The robot stands on the wordmark's baseline, sized to the type. */
  .brand {
    grid-area: mark;
    justify-self: start;
    display: flex;
    align-items: baseline;
    gap: 0.3em;
    font-size: clamp(1.625rem, 2.2vw, 1.875rem);
  }

  .wordmark {
    font-family: var(--font-serif);
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .nav {
    grid-area: nav;
    display: flex;
    justify-content: space-between;
    gap: 2px;
    padding: 4px;
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--card);
    scrollbar-width: none;
  }

  .nav a {
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav a:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .nav a[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }

  .actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .contact {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    border-radius: 999px;
    text-decoration: none;
  }

  .contact {
    padding: 0 1.25rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .contact:hover {
    background: var(--ink-soft);
    color: var(--paper);
  }

  /* On a phone the sections don't fit one row: they wrap, all of them in view. */
  @media (max-width: 39.99rem) {
    .nav {
      flex-wrap: wrap;
      justify-content: center;
      border-radius: 1.5rem;
    }
  }

  @media (min-width: 60rem) {
    .nav {
      padding: 5px;
    }

    .nav a {
      padding: 0.7rem 1.25rem;
      font-size: 0.9375rem;
    }

    .actions {
      justify-self: end;
      gap: 0.625rem;
    }

    .contact {
      height: 2.875rem;
    }

    .contact {
      padding: 0 1.375rem;
    }
  }

  @media (min-width: 66rem) {
    .bar {
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas: 'mark nav actions';
      min-height: 5rem;
    }
  }

  main {
    min-height: 70vh;
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .site-footer {
    padding-bottom: calc(var(--band) + clamp(1rem, 2vw, 1.5rem));
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule-strong);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .foot p {
    margin: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
  }
</style>
