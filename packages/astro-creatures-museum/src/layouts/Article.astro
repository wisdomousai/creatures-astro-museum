---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  /** Small line above the title, e.g. "No. 3" or "Reference project". */
  kicker?: string;
  canonical?: string;
  /** h2 headings become a sticky contents list in the rail on wide screens. */
  headings?: MarkdownHeading[];
  type?: 'website' | 'article';
}

const { title, description, kicker, canonical, headings = [], type = 'article' } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={description} canonical={canonical} type={type}>
  <slot name="head" slot="head" />
  <article class="article page grid" data-pagefind-body>
    <header class="head main-wide">
      {kicker && <p class="kicker caption">{kicker}</p>}
      <h1>{title}</h1>
      <p class="standfirst">{description}</p>
      <slot name="header" />
    </header>

    <aside class="rail" data-pagefind-ignore>
      <div class="rail-inner">
        <div class="meta caption"><slot name="meta" /></div>
        {
          toc.length > 2 && (
            <nav class="toc" aria-label="Contents">
              <p class="caption">Contents</p>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </div>
    </aside>

    <div class="body main">
      <div class="prose">
        <slot />
      </div>
      <footer class="foot caption">
        <slot name="footer" />
      </footer>
    </div>

    {
      Astro.slots.has('after') && (
        <div class="after">
          <slot name="after" />
        </div>
      )
    }
  </article>
</Base>

<style>
  .head {
    padding-block: clamp(3rem, 9vw, 7rem) clamp(2.5rem, 5vw, 4rem);
  }

  .kicker {
    margin: 0 0 1.25rem;
  }

  h1 {
    max-width: 22ch;
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  .standfirst {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    font-size: var(--text-md);
    font-style: italic;
    line-height: 1.4;
  }

  .rail {
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule-strong);
  }

  .meta:empty {
    display: none;
  }

  .meta :global(p) {
    margin: 0;
  }

  .toc {
    display: none;
  }

  .body {
    padding-top: 2.5rem;
  }

  .foot {
    max-width: var(--measure);
    margin-top: 4.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .foot:empty {
    display: none;
  }

  /* Full width under the body and rail, e.g. a closing contact block. */
  .after {
    margin-top: clamp(3rem, 7vw, 5.5rem);
  }

  .foot :global(p) {
    margin: 0 0 0.4rem;
  }

  @media (min-width: 60rem) {
    .head {
      grid-column: 4 / -1;
    }

    /* The body's top rule runs across rail and prose as one line. */
    .body {
      padding-top: 1.25rem;
      border-top: 1px solid var(--rule-strong);
    }

    .rail-inner {
      position: sticky;
      top: calc(var(--band) + 1.5rem);
      padding-right: 1rem;
    }

    .toc {
      display: block;
      margin-top: 2.5rem;
      font-family: var(--font-sans);
      font-size: 0.85rem;
      line-height: 1.35;
    }

    .toc .caption {
      margin: 0 0 0.75rem;
    }

    .toc ol {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .toc li + li {
      margin-top: 0.55rem;
    }

    .toc a {
      color: var(--ink-soft);
      text-decoration: none;
    }

    .toc a:hover {
      color: var(--accent);
    }
  }
</style>
