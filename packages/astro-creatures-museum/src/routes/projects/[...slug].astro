---
import Film from '../../components/mdx/Film.astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Article from '../../layouts/Article.astro';
import { domainOf, getProjects, hasCaseStudy } from '../../lib';
import { url as at } from '../../site';

export async function getStaticPaths() {
  const items = await getProjects();
  return items.filter(hasCaseStudy).map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { title, summary, url, role, period, stack, cover } = item.data;
const { Content, headings } = await render(item);

const facts = [
  ['Role', role],
  ['Period', period],
  ['Stack', stack.join(', ')],
].filter(([, value]) => value);

const links = url ? [{ href: url, label: domainOf(url) }] : [];
---

<Article title={title} description={summary} kicker="Project" headings={headings} type="website">
  <Fragment slot="header">
    {
      cover && (
        <Image
          class="cover"
          src={cover}
          alt=""
          widths={[800, 1400]}
          sizes="(max-width: 60rem) 100vw, 56rem"
        />
      )
    }
  </Fragment>

  <Fragment slot="meta">
    <dl class="facts">
      {
        facts.map(([term, value]) => (
          <div>
            <dt>{term}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
  </Fragment>

  <Content components={{ Film }} />

  <Fragment slot="footer">
    {
      links.length > 0 && (
        <p class="links">
          {links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </p>
      )
    }
    <p><a href={at('/projects')}>All projects</a></p>
  </Fragment>
</Article>

<style>
  .cover {
    width: 100%;
    margin-top: 2.5rem;
    border-radius: 2px;
  }

  .facts {
    margin: 0;
  }

  .facts div + div {
    margin-top: 0.75rem;
  }

  .facts dd {
    margin: 0.1rem 0 0;
    color: var(--ink);
  }
</style>
