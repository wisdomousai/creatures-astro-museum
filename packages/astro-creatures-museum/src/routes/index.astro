---
import Base from '../layouts/Base.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { getPosts, getProjects } from '../lib';
import { formatDate, site, url } from '../site';

const posts = (await getPosts()).slice(0, 3);
const projects = (await getProjects()).slice(0, 3);
// Named as in the nav.
const named = (href: string, fallback: string) =>
  site.nav.find((n) => n.href === href)?.label ?? fallback;
---

<Base museum="walk">
  <div class="home page">
    <h1>{site.title}</h1>

    <section class="section" aria-labelledby="blog-title">
      <div class="head">
        <h2 id="blog-title">{named('/blog', 'Blog')}</h2>
        <a class="more" href={url('/blog')}>All posts</a>
      </div>
      <ul class="posts">
        {
          posts.map((post) => (
            <li>
              <article class="post">
                <p class="meta">
                  <span>No. {post.number}</span>
                  <span aria-hidden="true">·</span>
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                </p>
                <h3>
                  <a href={url(`/blog/${post.id}`)}>{post.data.title}</a>
                </h3>
                <p class="description">{post.data.description}</p>
              </article>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="projects-title">
      <div class="head">
        <h2 id="projects-title">{named('/projects', 'Projects')}</h2>
        <a class="more" href={url('/projects')}>All projects</a>
      </div>
      <ProjectCards items={projects} />
    </section>
  </div>
</Base>

<style>
  .home {
    font-family: var(--font-sans);
  }

  h1 {
    margin: clamp(2.5rem, 6vw, 5rem) 0 clamp(2rem, 5vw, 4rem);
    font-size: clamp(2.25rem, 1.4rem + 3vw, 3.5rem);
  }

  .section {
    --card-min: 13rem;
    display: grid;
    gap: 1.25rem;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--rule-strong);
  }

  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .section h2 {
    margin: 0;
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .more {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .posts {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The whole card is clickable; the title stays the link text. */
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--rule);
    border-radius: clamp(20px, 2vw, 24px);
    background: var(--card);
  }

  .post:hover {
    border-color: var(--ink);
  }

  .post .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.625rem;
    margin: 0;
    color: var(--ink-faint);
    font-size: 0.875rem;
  }

  .post h3 {
    max-width: 54rem;
    margin: 0;
    font-size: clamp(1.35rem, 2.2vw, 1.875rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .post h3 a {
    text-decoration: none;
  }

  .post h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .post .description {
    max-width: 42.5rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.5;
  }

  @media (min-width: 60rem) {
    .section {
      gap: 2rem;
      padding-block: 3rem 3.5rem;
    }
  }

  /* Heading beside its section once the cards still get three across. */
  @media (min-width: 75rem) {
    .section {
      grid-template-columns: minmax(12rem, 18.75rem) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
</style>
