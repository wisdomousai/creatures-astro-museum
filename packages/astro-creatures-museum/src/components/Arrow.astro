---
// The right arrow used on buttons and link cards. Decorative: the link text says where it goes.
interface Props {
  size?: number;
}

const { size = 18 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d="M5 12h14M13 6l6 6-6 6"></path>
</svg>

<style>
  svg {
    flex-shrink: 0;
  }

  path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
